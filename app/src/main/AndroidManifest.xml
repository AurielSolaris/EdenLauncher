<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A launcher legitimately needs the full package list to build the app drawer (Phase 2);
         this is one of the sanctioned uses of the permission. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!--
        Needed to launch the system uninstall confirmation. Without it the platform silently drops
        the intent since Android 8 - no exception, no log, nothing happens - which is exactly what
        it looked like. Eden never uninstalls anything itself; this only opens the system's own
        dialog, and the system still asks.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
        Only for the music visualiser, and only if the user turns real audio on. The Visualizer
        API taps the device's output mix rather than the microphone - it cannot hear the room -
        but Android gates it behind this permission regardless. The wallpaper runs on an invented
        rhythm unless asked otherwise, so this is never requested by default.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Walkaround tilts with the phone; every other wallpaper works without it. -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <!--
        Icon packs, and the pickers Eden hands off to.

        QUERY_ALL_PACKAGES above already grants all of this, so strictly none of it is needed
        today. It is declared anyway because it is the honest statement of what Eden actually
        looks for: if the drawer ever stops needing the full package list, this block is what
        keeps icon packs working after the permission is dropped.

        There is no Android API for icon packs and never was - a pack advertises itself with
        whichever theme action its author's launcher of choice used, so all the common ones are
        listed. Missing one means silently not seeing packs the user has installed.
    -->
    <queries>
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="ch.deletescape.lawnchair.ICONPACK" />
        </intent>

        <!-- The document picker, for custom icons, wallpapers, and videos. -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>

        <!-- Third-party live wallpapers listed in the picker. -->
        <intent>
            <action android:name="android.service.wallpaper.WallpaperService" />
        </intent>
    </queries>

    <application
        android:name=".EdenApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eden">

        <activity
            android:name=".Launcher"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Eden"
            android:windowSoftInputMode="adjustPan">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            "Add to home screen" requests from other apps. Since Android 8 the system routes
            ShortcutManager.requestPinShortcut here; without this filter those buttons do nothing.
            Transparent and finishing immediately, so it reads as an action rather than a screen.
        -->
        <activity
            android:name=".PinItemRequestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Eden's own settings. Exported as a launcher entry as well as being reachable from a
            long press on the home screen: OEM Settings apps differ wildly and some hide or drop
            the "home app" preferences entirely, so the launcher cannot rely on any of them to be
            the way in to its own options.
        -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.EdenSettings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The last 48 hours of Eden's own log, on screen. A launcher crash takes the home screen
            with it and the user's next move is a reboot, which is exactly what clears logcat, so
            the log has to be readable from the device itself.
        -->
        <activity
            android:name=".settings.LogViewerActivity"
            android:exported="false"
            android:label="@string/settings_log_title"
            android:theme="@style/Theme.EdenSettings" />

        <!--
            Hands out a read grant for the log file and nothing else - see res/xml/log_paths.xml.
            Not exported: only the share intent's temporary grant opens it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_paths" />
        </provider>

        <!--
            Eden's own wallpaper picker. Previews here are still frames rendered offscreen, so
            browsing never starts a wallpaper service and nothing is lost if something else takes
            the foreground while you are looking.
        -->
        <activity
            android:name=".wallpaper.picker.WallpaperPickerActivity"
            android:exported="true"
            android:label="@string/wallpaper_picker_title"
            android:theme="@style/Theme.EdenSettings">
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Browses every icon in the selected pack, for the apps a pack has no entry for.
            Reached from an icon's long-press menu only.
        -->
        <activity
            android:name=".icons.IconPickerActivity"
            android:exported="false"
            android:label="@string/icon_picker_title"
            android:theme="@style/Theme.EdenSettings" />

        <!--
            Framing for a static wallpaper. Reached from the picker, never on its own, so it is
            not exported and carries no intent filter.
        -->
        <activity
            android:name=".wallpaper.picker.WallpaperCropActivity"
            android:exported="false"
            android:label="@string/wallpaper_crop_title"
            android:theme="@style/Theme.EdenSettings" />

        <!--
            Bundled live wallpapers.

            All four are rewrites of AOSP originals that no longer ship and could not be built if
            they did: they were RenderScript, which the Android Gradle plugin dropped in 9.0. See
            NOTICE for what each one derives from.
        -->
        <service
            android:name=".wallpaper.live.PhaseBeamWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_phasebeam"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_phasebeam" />
        </service>

        <service
            android:name=".wallpaper.live.NoiseFieldWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_noisefield"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_noisefield" />
        </service>

        <service
            android:name=".wallpaper.live.Galaxy4WallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_galaxy4"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_galaxy4" />
        </service>

        <service
            android:name=".wallpaper.live.GrassWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_grass"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_grass" />
        </service>

        <service
            android:name=".wallpaper.live.HoloSpiralWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_holospiral"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_holospiral" />
        </service>

        <service
            android:name=".wallpaper.live.MagicSmokeWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_magicsmoke"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_magicsmoke" />
        </service>

        <service
            android:name=".wallpaper.live.NexusWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_nexus"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_nexus" />
        </service>

        <service
            android:name=".wallpaper.live.FallWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_fall"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_fall" />
        </service>

        <service
            android:name=".wallpaper.live.PolarClockWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_polarclock"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_polarclock" />
        </service>

        <!-- Reads the accelerometer while it is drawing, and drops it the moment it is not. -->
        <service
            android:name=".wallpaper.live.WalkaroundWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_walkaround"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_walkaround" />
        </service>

        <!--
            The visualiser. Runs on an invented rhythm by default and needs no permission for
            that; RECORD_AUDIO is requested only if the user turns real audio on in settings.
        -->
        <service
            android:name=".wallpaper.live.MusicVisualizationWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_musicvis"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_musicvis" />
        </service>

        <!-- Plays the video the user imported, converted to 1080p at 24fps by MediaCodec. -->
        <service
            android:name=".wallpaper.VideoWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_video_current"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_video" />
        </service>

    </application>

</manifest>
