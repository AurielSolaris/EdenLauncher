<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Grid metrics read by DeviceProfile. Names follow AOSP Launcher3 so the reference
         sources stay searchable against this project. -->
    <dimen name="dynamic_grid_edge_margin">8dp</dimen>
    <dimen name="dynamic_grid_icon_drawable_padding">6dp</dimen>

    <!-- Breathing room inside every icon cell, so a grid of icons is not wall-to-wall artwork. -->
    <dimen name="icon_cell_padding_horizontal">4dp</dimen>
    <dimen name="icon_cell_padding_vertical">10dp</dimen>
    <dimen name="dynamic_grid_page_indicator_height">24dp</dimen>
    <dimen name="dynamic_grid_hotseat_padding">8dp</dimen>

    <!-- Fallback dock height used by the layout before DeviceProfile applies insets. -->
    <dimen name="dynamic_grid_hotseat_bar_height">72dp</dimen>

    <!-- Drop target bar shown at the top of the screen during a drag. -->
    <dimen name="drop_target_bar_height">56dp</dimen>

    <!-- App drawer. -->
    <dimen name="all_apps_search_padding">16dp</dimen>
    <!-- Breathing room around the paged drawer's dots, above the gesture bar. -->
    <dimen name="all_apps_page_dots_margin">10dp</dimen>
    <dimen name="all_apps_grid_padding_horizontal">12dp</dimen>
    <dimen name="all_apps_grid_padding_vertical">8dp</dimen>

    <!-- Zoomed-out overview panel. -->
    <dimen name="overview_panel_height">96dp</dimen>
    <dimen name="overview_panel_padding">12dp</dimen>
    <dimen name="overview_icon_size">32dp</dimen>

    <!-- Settings screen. -->
    <dimen name="settings_padding">20dp</dimen>
    <dimen name="settings_row_spacing">14dp</dimen>

    <!-- Per-icon options menu. -->
    <dimen name="icon_options_padding">18dp</dimen>
    <dimen name="icon_options_row_padding">12dp</dimen>
    <dimen name="icon_options_corner_radius">16dp</dimen>

    <!-- Widget picker. Big enough to tell two widgets from the same app apart. -->
    <dimen name="widget_picker_preview_size">72dp</dimen>

    <!-- Open folder panel. -->
    <dimen name="folder_corner_radius">20dp</dimen>
    <dimen name="folder_padding">12dp</dimen>
</resources>
