<?xml version="1.0" encoding="utf-8"?>
<!--
    One row in the widget picker. A quiet raised surface rather than a card with a heavy outline:
    the previews are the colourful part of this list and the container should not compete.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_picker_row" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="@color/settings_control_stroke" />
</shape>
