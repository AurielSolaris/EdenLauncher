<?xml version="1.0" encoding="utf-8"?>
<!--
    An outlined, accented box for the settings dropdowns.

    The platform Spinner on a dark background is a bare line of text that looks like a heading, so
    people do not think to tap it. An accent border says "this is a control with a current value",
    which is exactly what it is.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_control_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_control_stroke" />
            <corners android:radius="10dp" />
            <padding
                android:left="14dp"
                android:top="12dp"
                android:right="44dp"
                android:bottom="12dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/settings_spinner_caret"
        android:gravity="center_vertical|end"
        android:end="12dp"
        android:width="20dp"
        android:height="20dp" />
</layer-list>
